# olcli has built-in ignores for common LaTeX artifacts. These project-specific
# rules keep local package-manager files and editor state out of Overleaf.
node_modules/
package.json
package-lock.json
npm-debug.log*
Makefile
README.md
scripts/
.gitignore
.olignore
.olcli.json
.DS_Store
.vscode/
.idea/

# Keep local downloaded PDFs out of Overleaf unless explicitly renamed as figures.
soliloquy.pdf
*.synctex.gz
