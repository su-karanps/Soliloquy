{
  "name": "soliloquy-paper",
  "private": true,
  "description": "Overleaf-backed LaTeX paper workspace for the Soliloquy project.",
  "scripts": {
    "olcli": "olcli",
    "overleaf:auth": "olcli auth",
    "overleaf:check": "olcli check",
    "overleaf:list": "olcli list",
    "overleaf:pull": "olcli pull",
    "overleaf:push": "olcli push .",
    "overleaf:sync": "olcli sync .",
    "overleaf:sync:no-delete": "olcli sync . --no-delete",
    "overleaf:pdf": "olcli pdf -o soliloquy.pdf",
    "overleaf:bbl": "olcli output bbl -o main.bbl",
    "figures:sync": "bash scripts/sync-results-figures.sh"
  },
  "dependencies": {
    "@aloth/olcli": "https://github.com/aloth/olcli/archive/95007ca4707094aae2d2615ccde89964747e3e03.tar.gz"
  },
  "engines": {
    "node": ">=18"
  }
}
